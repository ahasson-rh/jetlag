# Jetlag ACM CoreDNS Hosts Configuration
# Generated from OpenNebula VM allocations
# Do not edit manually - regenerated by hv-acm-coredns role

hosts {
    # Bastion node
{% for network in controlplane_network %}
    {{ network | ansible.utils.nthhost(1) }} {{ groups['bastion'][0] }}
{% endfor %}

    # ACM Spoke VMs from OpenNebula
{% if opennebula_vms is defined and opennebula_vms.VM is defined %}
{%   for vm in opennebula_vms.VM %}
{%     set vm_user_template = vm.user_template %}
{%     if vm_user_template.SPOKE_GROUP is defined and vm_user_template.ROLE_AFFINITY_GROUP is defined %}
{%       set spoke_group = vm_user_template.SPOKE_GROUP %}
{%       set role_affinity = vm_user_template.ROLE_AFFINITY_GROUP %}
{%       set role = role_affinity.split('-')[-2] %}
{%       set vm_id = vm.id %}
{%       set vm_host = vm.hostname %}
{%       set vm_ip = vm.template.NIC[0].IP %}
    {{ vm_ip }} {{ spoke_group }}-{{ role }}-{{ loop.index0 }}.{{ base_dns_name }}
    {{ vm_ip }} one-{{ vm_id }}
{%     endif %}
{%   endfor %}
{% endif %}
    fallthrough
}

# Wildcard application routing per spoke
{% if opennebula_vms is defined and opennebula_vms.VM is defined %}
{%   set spoke_ips = {} %}
{%   for vm in opennebula_vms.VM %}
{%     set vm_user_template = vm.user_template %}
{%     if vm_user_template.SPOKE_GROUP is defined %}
{%       set spoke_group = vm_user_template.SPOKE_GROUP %}
{%       set vm_ip = vm.template.NIC[0].IP %}
{%       if spoke_group not in spoke_ips %}
{%         set _ = spoke_ips.update({spoke_group: vm_ip}) %}
{%       endif %}
{%     endif %}
{%   endfor %}
{%   for spoke, ip in spoke_ips.items() %}

# Wildcard apps routing for {{ spoke }}
{%     if ip | ansible.utils.ipv4 %}
template IN A {{ spoke }}.{{ base_dns_name }} {
    match .*.apps.{{ spoke }}.{{ base_dns_name }}
    answer "{%raw%}{{ .Name }} 60 in {{ .Type }}{%endraw%} {{ ip }}"
    fallthrough
}
{%     else %}
template IN AAAA {{ spoke }}.{{ base_dns_name }} {
    match .*.apps.{{ spoke }}.{{ base_dns_name }}
    answer "{%raw%}{{ .Name }} 60 in {{ .Type }}{%endraw%} {{ ip }}"
    fallthrough
}
{%     endif %}
{%   endfor %}
{% endif %}
